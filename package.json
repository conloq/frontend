{
  "name": "mash",
  "version": "1.0.0",
  "description": "Frontend EJS do Sistema MASH",
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "test": "node --check index.js && node scripts/verify-profile-contract.mjs && node scripts/verify-upload.mjs && node scripts/verify-client.mjs",
    "start": "nodemon index.js",
    "build:css": "tailwindcss -i public/css/tailwind.css -o public/css/style.css",
    "watch:css": "tailwindcss -i public/css/tailwind.css -o public/css/style.css --watch",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{js,mjs,css,json,html}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,css,json,html}\""
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "mysql2": "^3.24.6",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "^3.23.3"
    }
  },
  "type": "module",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3"
  },
  "lint-staged": {
    "*.{js,mjs,css,json,html}": "prettier --write"
  }
}
