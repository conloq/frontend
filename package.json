{
  "name": "mash-frontend",
  "version": "2.0.0",
  "private": true,
  "description": "Frontend React do Sistema MASH",
  "scripts": {
    "dev": "next dev -p 4000",
    "start": "next start -p 4000",
    "build": "npm run build:css && next build",
    "build:css": "tailwindcss -i public/css/tailwind.css -o public/css/style.css",
    "watch:css": "tailwindcss -i public/css/tailwind.css -o public/css/style.css --watch",
    "test": "node --test scripts/verify-frontend.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,css,json,html}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,css,json,html}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "axios": "^1.8.4",
    "next": "16.4.3",
    "react": "^19",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3"
  },
  "lint-staged": {
    "*.{js,mjs,css,json,html}": "prettier --write"
  }
}
