PORT=4000
API_URL=http://localhost:8080

# Segredo do cookie de sessão do Express; use um valor aleatório em produção.
SESSION_SECRET=change-this-before-deploy

# Conexão do frontend com o MySQL existente, somente para armazenar sessões.
# A conta deve ter acesso apenas à tabela `sessions`, criada pela migration do Back-End.
SESSION_DB_HOST=localhost
SESSION_DB_PORT=3306
# Use o mesmo banco MySQL do Back-End; não é necessário criar outro banco.
SESSION_DB_NAME=mash
SESSION_DB_USER=mash_frontend_session
SESSION_DB_PASSWORD=change-this

# Em desenvolvimento local, false. Em produção, TLS é ativado automaticamente.
SESSION_DB_SSL=false
# Para CA privada, informe o certificado PEM com quebras de linha como \n.
SESSION_DB_SSL_CA=
