<%- include ('partials/header.ejs') %>
<div class="app-shell min-h-screen bg-stone-100 lg:flex">
  <%- include ('partials/sidebar.ejs') %>
  <div class="app-shell-content min-w-0 flex-1">
    <%- include ('partials/topBar.ejs') %>
    <main class="mx-auto max-w-7xl space-y-6 p-4 sm:p-6">
      <div class="flex justify-end">
        <a
          href="/usuario/sair"
          class="inline-flex min-h-11 items-center gap-2 rounded-full border border-red-200 px-4 py-2 font-semibold text-red-600 hover:bg-red-50"
          ><i class="ph ph-sign-out text-lg" aria-hidden="true"></i>Sair</a
        >
      </div>
      <section class="rounded-3xl bg-white p-5 shadow-sm sm:p-7">
        <div class="flex flex-wrap items-center gap-5">
          <button
            type="button"
            data-modal-open="modalFoto"
            class="relative shrink-0 rounded-full focus:outline-none focus:ring-4 focus:ring-orange-200"
            aria-label="Alterar foto"
          >
            <img
              src="/img/foto-perfil.png"
              class="size-24 rounded-full object-cover sm:size-28"
              alt="Foto de Ana Beatriz"
            /><span
              class="absolute bottom-0 right-0 grid size-8 place-items-center rounded-full bg-white shadow"
              >⌕</span
            >
          </button>
          <div>
            <h1 class="text-2xl font-bold text-mash-brown sm:text-3xl">
              Ana Beatriz
            </h1>
            <p class="text-stone-500">ana@exemplo.com</p>
          </div>
        </div>
        <div class="mt-6 border-t border-stone-100 pt-4 text-sm">
          <span class="font-semibold uppercase tracking-wide text-stone-400"
            >Entrou em:</span
          >
          <span class="ml-2 font-semibold"> 15/01/2026 </span>
        </div>
      </section>
      <section class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-3xl bg-white p-5 shadow-sm sm:p-7">
          <h2 class="mb-6 text-xl font-bold text-mash-brown">
            Informações do usuário
          </h2>
          <form onsubmit="return false;" id="formPerfil" class="space-y-4">
            <label class="block text-sm font-semibold"
              >Nome completo<input
                type="text"
                id="nome"
                name="nome"
                value="Ana Beatriz"
                disabled
                class="mt-2 w-full rounded-xl border border-stone-200 px-4 py-3 disabled:bg-stone-50" /></label
            ><label class="block text-sm font-semibold"
              >E-mail<input
                type="email"
                id="email"
                name="email"
                value="ana@exemplo.com"
                disabled
                class="mt-2 w-full rounded-xl border border-stone-200 px-4 py-3 disabled:bg-stone-50" /></label
            ><label class="block text-sm font-semibold"
              >Telefone<input
                type="tel"
                id="telefone"
                name="telefone"
                value="(11) 99999-0000"
                placeholder="Não informado"
                disabled
                class="mt-2 w-full rounded-xl border border-stone-200 px-4 py-3 disabled:bg-stone-50" /></label
            ><label class="block text-sm font-semibold"
              >Senha<input
                type="password"
                id="senha"
                name="senha"
                placeholder="********"
                disabled
                class="mt-2 w-full rounded-xl border border-stone-200 px-4 py-3 disabled:bg-stone-50"
            /></label>
            <div class="flex flex-wrap gap-3 pt-2">
              <button
                type="button"
                id="btnAlterar"
                class="min-h-11 rounded-xl bg-mash-brown px-4 py-2 font-semibold text-white"
              >
                Alterar dados</button
              ><button
                type="submit"
                id="btnSalvar"
                disabled
                class="min-h-11 rounded-xl bg-mash-orange px-4 py-2 font-semibold text-white disabled:opacity-50"
              >
                Salvar alterações</button
              ><a
                href="/usuario/deletar"
                id="btnExcluir"
                class="inline-flex min-h-11 items-center rounded-xl border border-red-200 px-4 py-2 font-semibold text-red-600"
                >Excluir usuário</a
              >
            </div>
          </form>
        </div>
        <div class="rounded-3xl bg-white p-5 shadow-sm sm:p-7">
          <h2 class="mb-6 text-xl font-bold text-mash-brown">
            ÚÚltimos logins
          </h2>
          <div class="overflow-x-auto">
            <div class="min-w-[600px]">
              <div
                class="grid grid-cols-4 gap-3 border-b border-stone-100 pb-3 text-xs font-bold uppercase tracking-wide text-stone-400"
              >
                <span>Data & Hora</span><span>Endereço IP</span
                ><span>Localidade</span><span>Status</span>
              </div>
              <div class="max-h-80 overflow-y-auto pt-3">
                <div
                  class="grid grid-cols-4 gap-3 border-b border-stone-50 py-3 text-sm"
                >
                  <span
                    ><strong>25/08/2026</strong
                    ><small class="block text-stone-400">09:30</small></span
                  ><span>127.0.0.1</span><span>Localhost</span
                  ><span class="font-semibold text-green-600"
                    >Login seguro</span
                  >
                </div>
                <div
                  class="grid grid-cols-4 gap-3 border-b border-stone-50 py-3 text-sm"
                >
                  <span
                    ><strong>24/08/2026</strong
                    ><small class="block text-stone-400">18:12</small></span
                  ><span>192.168.0.20</span><span>São Paulo, Brasil</span
                  ><span class="font-semibold text-amber-600"
                    >Novo dispositivo</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>
<div
  id="modalFoto"
  class="js-modal fixed inset-0 z-50 hidden overflow-y-auto bg-stone-950/60 p-4"
  aria-hidden="true"
>
  <div class="mx-auto flex min-h-full max-w-md items-center">
    <div
      class="w-full rounded-3xl bg-white p-6 shadow-xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modalFotoLabel"
    >
      <div class="flex items-center justify-between">
        <h2 id="modalFotoLabel" class="text-xl font-bold text-mash-brown">
          Alterar foto de perfil
        </h2>
        <button
          type="button"
          data-modal-close
          class="rounded-lg p-2 text-2xl text-stone-500"
          aria-label="Fechar"
        >
          ×
        </button>
      </div>
      <form
        onsubmit="return false;"
        enctype="multipart/form-data"
        id="formFoto"
        class="mt-5"
      >
        <img
          id="previewFoto"
          src="/img/foto-perfil.png"
          class="mx-auto mb-5 size-32 rounded-full object-cover ring-4 ring-stone-100"
          alt="Prévia da foto"
        /><label for="inputFoto" class="block text-sm font-bold"
          >Escolher imagem</label
        ><input
          type="file"
          id="inputFoto"
          name="foto"
          accept="image/png, image/jpeg, image/webp"
          class="mt-2 w-full rounded-xl border border-stone-200 p-3"
        /><small class="mt-2 block text-sm text-stone-500"
          >JPG, PNG ou JPEG. Tamanho máximo: 2 MB.</small
        >
        <div class="mt-6 flex justify-end gap-3">
          <button
            type="button"
            data-modal-close
            class="min-h-11 rounded-xl border border-stone-200 px-4 font-semibold"
          >
            Cancelar</button
          ><button
            type="submit"
            class="min-h-11 rounded-xl bg-mash-orange px-5 font-bold text-white"
          >
            Salvar
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include ('partials/footer.ejs') %>
