<%- include('partials/shellInicio.ejs', { titulo: 'Perfil', trilha: ['Conta', 'Perfil'] }) %>
<div class="flex flex-col gap-1.5">
  <h1 class="text-[30px] font-semibold">Perfil</h1>
  <p class="text-texto-2">Conta criada em <span data-user="createdAt">—</span>.</p>
</div>

<div class="grid gap-6 xl:grid-cols-[400px_minmax(0,1fr)]">
  <div class="flex flex-col gap-6">
    <section class="card flex flex-col items-center gap-5 p-6" aria-labelledby="tituloFoto">
      <div class="flex w-full flex-col gap-0.5">
        <h2 id="tituloFoto" class="text-lg font-semibold">Foto do perfil</h2>
        <p class="text-sm text-texto-2">JPEG ou PNG. Aparece no topo das telas.</p>
      </div>
      <form id="formFoto" class="flex w-full flex-col items-center gap-4" novalidate>
        <img id="previewFoto" data-user="urlImage" src="/img/foto-perfil.png" alt="Sua foto de perfil" class="size-32 rounded-full border-4 border-linha object-cover">
        <label class="btn-secundario w-full cursor-pointer focus-within:outline-3 focus-within:outline-foco">
          <i class="ph ph-image" aria-hidden="true"></i>Escolher foto
          <input id="inputFoto" name="image" type="file" accept="image/jpeg,image/png" class="sr-only">
        </label>
        <button type="submit" class="btn-primario w-full"><i class="ph ph-upload-simple" aria-hidden="true"></i>Enviar foto</button>
      </form>
    </section>

    <%# Histórico de logins: a API ainda não tem rota; as linhas seguem o desenho do Pen %>
    <section class="card flex flex-col p-6" aria-labelledby="tituloAcessos">
      <div class="flex flex-col gap-0.5 pb-2">
        <h2 id="tituloAcessos" class="text-lg font-semibold">Últimos acessos</h2>
        <p class="text-sm text-texto-2">Entradas recentes na sua conta.</p>
      </div>
      <ul class="flex flex-col">
        <% [['Registro, SP', '15/01/2026 · 22:00 · 192.168.1.104', 'selo-sucesso', 'Este dispositivo'],
            ['Jacupiranga, SP', '12/01/2026 · 21:00 · 192.167.1.10', 'selo-aviso', 'Novo dispositivo'],
            ['Registro, SP', '10/01/2026 · 08:15 · 192.168.1.104', 'selo-sucesso', 'Login seguro']].forEach(([local, quando, selo, status]) => { %>
          <li class="flex items-center gap-3 border-b border-linha py-3 last:border-b-0">
            <span class="grid size-9 shrink-0 place-items-center rounded-[10px] bg-fundo"><i class="ph ph-map-pin text-lg text-texto-2" aria-hidden="true"></i></span>
            <span class="flex min-w-0 flex-1 flex-col"><span class="text-sm font-semibold"><%= local %></span><span class="text-[13px] text-texto-2"><%= quando %></span></span>
            <span class="<%= selo %>"><%= status %></span>
          </li>
        <% }) %>
      </ul>
    </section>

    <section class="card flex flex-col gap-5 border-[#f2c9c4] p-6" aria-labelledby="tituloExcluirConta">
      <div class="flex flex-col gap-0.5">
        <h2 id="tituloExcluirConta" class="text-lg font-semibold">Excluir conta</h2>
        <p class="text-sm text-texto-2">Apaga sua conta e sai do MASH. Não dá para desfazer.</p>
      </div>
      <button type="button" id="btnExcluir" class="btn-perigo w-full"><i class="ph ph-trash" aria-hidden="true"></i>Excluir minha conta</button>
    </section>
  </div>

  <form id="formPerfil" method="post" class="card flex flex-col gap-5 self-start p-6" novalidate>
    <h2 class="text-lg font-semibold">Dados da conta</h2>
    <div class="grid gap-5 md:grid-cols-2">
      <div class="campo" data-campo="name">
        <label class="campo-rotulo" for="nome">Nome completo</label>
        <span class="campo-caixa"><input id="nome" name="name" autocomplete="name" required></span>
        <span class="campo-ajuda" data-erro></span>
      </div>
      <div class="campo" data-campo="phone">
        <label class="campo-rotulo" for="telefone">Telefone (opcional)</label>
        <span class="campo-caixa"><input id="telefone" name="phone" type="tel" autocomplete="tel" placeholder="(13) 99999-0000"></span>
      </div>
    </div>
    <div class="campo" data-campo="email">
      <label class="campo-rotulo" for="email">E-mail</label>
      <span class="campo-caixa"><input id="email" name="email" type="email" autocomplete="email" required></span>
      <span class="campo-ajuda" data-erro></span>
    </div>
    <hr class="border-linha">
    <div class="flex flex-col gap-0.5">
      <h2 class="text-lg font-semibold">Trocar senha</h2>
      <p class="text-sm text-texto-2">Deixe em branco para manter a senha atual.</p>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      <div class="campo" data-campo="password">
        <label class="campo-rotulo" for="senha">Nova senha</label>
        <span class="campo-caixa">
          <input id="senha" name="password" type="password" autocomplete="new-password">
          <button type="button" class="btn-icone -mr-2" data-toggle-senha="senha" aria-label="Mostrar senha"><i class="ph ph-eye" aria-hidden="true"></i></button>
        </span>
        <span class="campo-ajuda" data-erro>Sem espaços.</span>
      </div>
      <div class="campo" data-campo="confirmarSenha">
        <label class="campo-rotulo" for="confirmarSenha">Confirmar nova senha</label>
        <span class="campo-caixa">
          <input id="confirmarSenha" name="confirmarSenha" type="password" autocomplete="new-password">
          <button type="button" class="btn-icone -mr-2" data-toggle-senha="confirmarSenha" aria-label="Mostrar senha"><i class="ph ph-eye" aria-hidden="true"></i></button>
        </span>
        <span class="campo-ajuda" data-erro></span>
      </div>
    </div>
    <div class="flex flex-wrap justify-end gap-3 pt-2">
      <button type="button" id="btnDescartar" class="btn-secundario">Descartar</button>
      <button type="submit" id="btnSalvar" disabled class="btn-primario">Salvar alterações</button>
    </div>
  </form>
</div>
<%- include('partials/shellFim.ejs') %>
