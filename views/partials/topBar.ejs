<%# Header marrom: trilha à esquerda, conta à direita. Recebe trilha = [seção, página]. %>
<% const _trilha = typeof trilha !== 'undefined' ? trilha : []; %>
<header class="flex h-16 items-center gap-2 bg-mash-brown px-2 text-white sm:px-4 lg:h-18 lg:px-8">
  <button type="button" class="sidebar-open btn-icone text-white hover:bg-white/10 lg:hidden" aria-label="Abrir menu" aria-controls="appSidebar" aria-expanded="false">
    <i class="ph ph-list text-2xl" aria-hidden="true"></i>
  </button>
  <nav aria-label="Você está em" class="min-w-0 flex-1">
    <ol class="flex items-center gap-2 text-[15px]">
      <% _trilha.forEach((item, i) => { %>
        <% if (i > 0) { %><li aria-hidden="true"><i class="ph ph-caret-right text-sm text-header-texto-2"></i></li><% } %>
        <li class="<%= i === _trilha.length - 1 ? 'truncate font-semibold text-white' : 'hidden text-header-texto-2 sm:block' %>"<%- i === _trilha.length - 1 ? ' aria-current="page"' : '' %> <%- i === _trilha.length - 1 ? 'data-trilha-atual' : '' %>><%= item %></li>
      <% }) %>
    </ol>
  </nav>
  <a href="/usuario" class="flex min-h-11 items-center gap-3 rounded-[10px] p-1 transition-colors hover:bg-white/10" aria-label="Abrir perfil">
    <img data-user="urlImage" class="size-9 rounded-full border-2 border-white object-cover lg:size-10" src="/img/foto-perfil.png" alt="">
    <span class="hidden text-right md:block">
      <span data-user="name" class="block text-[15px] font-semibold leading-tight"></span>
      <span data-user="email" class="block text-[13px] text-header-texto-2"></span>
    </span>
  </a>
</header>
