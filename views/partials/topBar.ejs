<header class="flex items-center justify-between gap-4 bg-mash-brown px-4 py-3 text-white shadow-sm sm:px-6 lg:px-8">
  <button type="button" class="sidebar-open inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg p-2 text-white transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white lg:hidden" aria-label="Abrir menu" aria-controls="appSidebar" aria-expanded="false"><i class="ph ph-list text-xl" aria-hidden="true"></i></button>
  <div class="ml-auto flex items-center gap-3">
    <a href="/usuario" class="flex items-center gap-3 rounded-lg p-1 transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white" aria-label="Abrir perfil">
      <img data-user="urlImage" class="size-10 rounded-full object-cover" src="/img/foto-perfil.png" alt="Foto do perfil">
      <span class="hidden text-right md:block">
        <span data-user="name" class="block font-semibold"></span>
        <span data-user="email" class="block text-xs text-white/70"></span>
      </span>
    </a>
  </div>
</header>
