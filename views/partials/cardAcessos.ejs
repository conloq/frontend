<%# Card "Últimos acessos", preenchido no servidor com dados da API. %>
<section class="card flex flex-col p-6 max-lg:px-4 max-lg:py-1 <%= locals.classe ?? '' %>" aria-labelledby="tituloAcessos">
  <div class="flex flex-col gap-0.5 pb-2 max-lg:sr-only">
    <h2 id="tituloAcessos" class="text-lg font-semibold">Últimos acessos</h2>
    <p class="text-sm text-texto-2">Entradas recentes na sua conta.</p>
  </div>
  <div id="listaAcessos" class="flex flex-col" role="list" aria-live="polite">
    <% if (locals.erroAcessos) { %>
      <p class="py-4 text-sm text-perigo">Não foi possível carregar os acessos. Tente novamente.</p>
    <% } else { (locals.acessos ?? []).forEach((acesso) => { %>
      <div class="flex items-center gap-3 border-b border-linha py-3 last:border-b-0" role="listitem">
        <span class="grid size-9 shrink-0 place-items-center rounded-[10px] bg-fundo max-lg:hidden"><i class="ph ph-map-pin text-lg text-texto-2" aria-hidden="true"></i></span>
        <span class="flex min-w-0 flex-1 flex-col"><span class="text-sm font-semibold"><%= acesso.location %></span><span class="text-[13px] text-texto-2"><%= new Date(acesso.loggedAt).toLocaleDateString('pt-BR') %> · <%= new Date(acesso.loggedAt).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %> · <%= acesso.ipAddress %></span></span>
        <% if (acesso.status !== null && acesso.status !== undefined) { %><span class="<%= acesso.status ? 'selo-sucesso' : 'selo-aviso' %>"><%= acesso.status ? 'Dispositivo conhecido' : 'Novo dispositivo' %></span><% } %>
      </div>
    <% }) %>
    <% if (!locals.acessos?.length) { %><p class="py-4 text-sm text-texto-2">Nenhum acesso registrado</p><% } } %>
  </div>
</section>
