<%# Novo lote / editar lote em modal (folha no mobile). Recebe editando, voltar (URL da tela por baixo) e abrir (abre ao carregar). A API não tem rota de lotes: o formulário usa data-sem-api; as receitas vêm de GET /recipes. %>
<div id="modalLote" class="js-modal folha fixed inset-0 z-50 hidden bg-texto/60 p-4" aria-hidden="true"<% if (locals.abrir) { %> data-abrir data-voltar="<%= voltar %>"<% } %>>
  <div class="flex min-h-full items-center justify-center">
    <div class="w-full max-w-[560px] overflow-hidden rounded-2xl bg-superficie shadow-[0_24px_48px_rgba(31,26,23,0.25)]" role="dialog" aria-modal="true" aria-labelledby="modalLoteTitulo">
      <div class="flex items-start gap-2 px-6 pb-0 pr-4 pt-6">
        <div class="flex flex-1 flex-col gap-1">
          <h2 id="modalLoteTitulo" class="text-[22px] font-semibold"><%= editando ? 'Editar lote' : 'Novo lote' %></h2>
          <% if (!editando) { %><p class="text-sm text-texto-2">Um lote é uma brassagem feita com uma das suas receitas.</p><% } %>
        </div>
        <button type="button" class="btn-icone" data-modal-close aria-label="Fechar"><i class="ph ph-x" aria-hidden="true"></i></button>
      </div>
      <form id="formLote" data-sem-api="conloq/mash#31" novalidate>
        <div class="flex flex-col gap-4 p-6">
          <label class="campo" for="loteNome">
            <span class="campo-rotulo">Nome do lote</span>
            <span class="campo-caixa"><input id="loteNome" name="name" maxlength="60" placeholder="Ex.: Lote 20/10" required></span>
          </label>
          <div class="campo" data-campo="recipeId">
            <label class="campo-rotulo" for="loteReceita">Receita</label>
            <span class="campo-caixa relative">
              <select id="loteReceita" name="recipeId" required>
                <% if (locals.erroReceitas) { %><option value="">Não foi possível carregar as receitas</option><% } else if (!(locals.receitas ?? []).length) { %><option value="">Nenhuma receita cadastrada</option><% } else { %>
                  <option value="">Escolha uma receita</option>
                  <% receitas.forEach((receita) => { %><option value="<%= receita.id %>"><%= receita.name %></option><% }) %>
                <% } %>
              </select>
              <i class="ph ph-caret-down pointer-events-none absolute right-3.5 text-lg!" aria-hidden="true"></i>
            </span>
            <span class="campo-ajuda" data-erro></span>
          </div>
          <div class="campo">
            <label class="campo-rotulo" for="loteInicio">Início da mosturação (opcional)</label>
            <span class="campo-caixa"><input id="loteInicio" name="startedAt" type="datetime-local"></span>
            <span class="campo-ajuda">Em branco, o MASH usa a data e a hora do cadastro.</span>
          </div>
          <div class="campo" role="radiogroup" aria-labelledby="loteStatusRotulo">
            <span id="loteStatusRotulo" class="campo-rotulo">Status</span>
            <div class="segmentado w-full">
              <label><input type="radio" name="status" value="andamento" class="sr-only" checked>Em andamento</label>
              <label><input type="radio" name="status" value="concluido" class="sr-only">Concluído</label>
            </div>
          </div>
        </div>
        <div class="acoes border-t border-linha bg-[#faf8f6] px-6 py-4">
          <button type="button" class="btn-secundario" data-modal-close>Cancelar</button>
          <button type="submit" class="btn-primario"><%= editando ? 'Salvar alterações' : 'Criar lote' %></button>
        </div>
      </form>
    </div>
  </div>
</div>
