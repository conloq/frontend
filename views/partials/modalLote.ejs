<%# Modal de lote (futuros POST /lots e PUT /lots/:id). Recebe titulo, descricao, botao e valores (edição). %>
<% const v = typeof valores !== 'undefined' ? valores : {}; %>
<div id="modalLote" class="js-modal fixed inset-0 z-50 hidden bg-texto/60 p-4" aria-hidden="true">
  <div class="flex min-h-full items-center justify-center">
    <div class="w-full max-w-[520px] overflow-hidden rounded-2xl bg-superficie shadow-[0_24px_48px_rgba(31,26,23,0.25)]" role="dialog" aria-modal="true" aria-labelledby="modalLoteTitulo">
      <div class="flex items-start gap-2 px-6 pb-0 pr-4 pt-6">
        <div class="flex flex-1 flex-col gap-1">
          <h2 id="modalLoteTitulo" class="text-[22px] font-semibold"><%= titulo %></h2>
          <% if (descricao) { %><p class="text-sm text-texto-2"><%= descricao %></p><% } %>
        </div>
        <button type="button" class="btn-icone" data-modal-close aria-label="Fechar"><i class="ph ph-x" aria-hidden="true"></i></button>
      </div>
      <form id="formLote" data-sem-api="conloq/mash#31" novalidate>
        <div class="flex flex-col gap-[18px] p-6">
          <div class="campo" data-campo="name">
            <label class="campo-rotulo" for="loteNome">Nome do lote</label>
            <span class="campo-caixa"><input id="loteNome" name="name" maxlength="255" placeholder="Ex.: Lote 20/10" value="<%= v.nome ?? '' %>" required></span>
            <span class="campo-ajuda" data-erro></span>
          </div>
          <div class="campo" data-campo="recipeId">
            <label class="campo-rotulo" for="loteReceita">Receita</label>
            <span class="campo-caixa">
              <select id="loteReceita" name="recipeId" required>
                <option value="">Escolha uma receita</option>
                <% ['American Pale Ale', 'Witbier', 'Dry Stout', 'Session IPA'].forEach((nome, i) => { %>
                  <option value="<%= i + 1 %>" <%= v.receita === nome ? 'selected' : '' %>><%= nome %></option>
                <% }) %>
              </select>
              <i class="ph ph-caret-down pointer-events-none -ml-6" aria-hidden="true"></i>
            </span>
            <span class="campo-ajuda" data-erro></span>
          </div>
          <div class="campo" data-campo="mashStart">
            <label class="campo-rotulo" for="loteInicio">Início da mosturação (opcional)</label>
            <span class="campo-caixa"><input id="loteInicio" name="mashStart" type="datetime-local" value="<%= v.inicio ?? '' %>"></span>
            <span class="campo-ajuda" data-erro>Em branco, o MASH usa a data e a hora do cadastro.</span>
          </div>
          <fieldset class="campo">
            <legend class="campo-rotulo mb-1.5">Status</legend>
            <div class="grid min-h-12 grid-cols-2 gap-1 rounded-[10px] bg-fundo p-1">
              <label class="flex cursor-pointer items-center justify-center rounded-lg text-sm font-medium text-texto-2 has-checked:bg-superficie has-checked:font-semibold has-checked:text-texto has-checked:shadow-sm has-focus-visible:outline-3 has-focus-visible:outline-foco">
                <input type="radio" name="status" value="active" class="sr-only" <%= v.status !== 'completed' ? 'checked' : '' %>>Em andamento
              </label>
              <label class="flex cursor-pointer items-center justify-center rounded-lg text-sm font-medium text-texto-2 has-checked:bg-superficie has-checked:font-semibold has-checked:text-texto has-checked:shadow-sm has-focus-visible:outline-3 has-focus-visible:outline-foco">
                <input type="radio" name="status" value="completed" class="sr-only" <%= v.status === 'completed' ? 'checked' : '' %>>Concluído
              </label>
            </div>
          </fieldset>
        </div>
        <div class="flex justify-end gap-3 border-t border-linha bg-[#faf8f6] px-6 py-4">
          <button type="button" class="btn-secundario" data-modal-close>Cancelar</button>
          <button type="submit" class="btn-primario"><%= botao %></button>
        </div>
      </form>
    </div>
  </div>
</div>
