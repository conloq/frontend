<%# Faixa da marca no topo das telas de acesso no mobile (no desktop a marca fica no painelMarca). Recebe chamada. %>
<div class="relative -mx-6 -mt-12 mb-2 w-[calc(100%+3rem)] overflow-hidden bg-mash-brown px-6 pb-7 pt-6 lg:hidden">
  <img src="/img/mash-emblema.png" alt="" class="pointer-events-none absolute -right-10 -top-4 w-56 opacity-25">
  <div class="relative flex items-center gap-2.5">
    <img src="/img/logo-mash.png" alt="" class="size-10 rounded-full">
    <span class="font-display text-xl font-bold tracking-[0.15em] text-white">MASH</span>
  </div>
  <p class="relative mt-7 font-display text-[26px] font-bold leading-tight text-white"><%= chamada %></p>
</div>
