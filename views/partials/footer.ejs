<%# Diálogo de confirmação: substitui o confirm() do navegador. app.js chama confirmar({...}). %>
<div id="dialogoConfirmar" class="folha fixed inset-0 z-[70] hidden items-center justify-center bg-texto/60 p-4" aria-hidden="true">
  <div class="w-full max-w-[440px] overflow-hidden rounded-2xl bg-superficie shadow-[0_24px_48px_rgba(31,26,23,0.25)]" role="alertdialog" aria-modal="true" aria-labelledby="dialogoConfirmarTitulo" aria-describedby="dialogoConfirmarMensagem">
    <div class="flex flex-col gap-4 p-6 pb-5">
      <div class="flex flex-col gap-1.5">
        <h2 id="dialogoConfirmarTitulo" class="text-xl font-semibold"></h2>
        <p id="dialogoConfirmarMensagem" class="leading-relaxed text-texto-2"></p>
      </div>
    </div>
    <div class="acoes border-t border-linha bg-[#faf8f6] px-6 py-4">
      <button type="button" class="btn-secundario" data-confirmar="nao">Cancelar</button>
      <button type="button" class="btn-perigo" data-confirmar="sim"><i class="ph ph-trash" aria-hidden="true"></i><span id="dialogoConfirmarBotao">Excluir</span></button>
    </div>
  </div>
</div>

<template id="tplAlerta">
  <div class="flex items-center gap-3 rounded-[10px] py-3 pl-4 pr-2">
    <i class="ph-fill text-[22px]" data-slot="icone" aria-hidden="true"></i>
    <div class="flex min-w-0 flex-1 flex-col gap-0.5">
      <p class="font-semibold" data-slot="titulo"></p>
      <p class="text-sm" data-slot="texto"></p>
    </div>
    <button type="button" class="btn-fantasma text-sm" data-slot="acao"><i class="ph ph-arrow-clockwise" aria-hidden="true"></i><span data-slot="acaoTexto"></span></button>
  </div>
</template>

<script src="/js/script.js?v=6"></script>
<script src="/js/app.js?v=10"></script>
</body>
</html>
