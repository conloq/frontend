<%# Menu lateral: 18rem aberto, 5rem recolhido (desktop); gaveta no mobile. public/js/script.js controla. %>
<aside id="appSidebar" class="fixed inset-y-0 left-0 z-40 flex shrink-0 -translate-x-full flex-col border-r border-linha bg-superficie px-4 pb-5 transition-[width,transform] duration-200 lg:translate-x-0" aria-label="Navegação principal" data-sidebar-state="expanded">
  <div class="sidebar-marca flex min-h-18 items-center justify-between gap-2">
    <a href="/recipes" class="flex min-w-0 items-center gap-2.5 rounded-[10px]" aria-label="MASH, ir para as receitas">
      <img src="/img/logo-mash.png" alt="" class="size-10 shrink-0 rounded-full object-cover">
      <span class="sidebar-label font-display text-xl font-bold tracking-wide">MASH</span>
    </a>
    <button type="button" class="sidebar-collapse btn-icone hidden lg:inline-flex" aria-label="Recolher menu" aria-controls="appSidebar" aria-expanded="true">
      <i class="ph ph-caret-double-left text-lg" aria-hidden="true"></i>
    </button>
    <button type="button" class="sidebar-close btn-icone lg:hidden" aria-label="Fechar menu">
      <i class="ph ph-x" aria-hidden="true"></i>
    </button>
  </div>

  <nav class="mt-3 flex flex-col gap-1">
    <a href="/recipes" data-secao="/recipes /temperatures" class="menu-link flex min-h-12 items-center gap-3 rounded-[10px] px-3.5 font-medium transition-colors hover:bg-hover-neutro" title="Receitas">
      <i class="ph ph-scroll text-[22px] text-texto-2" aria-hidden="true"></i>
      <span class="sidebar-label">Receitas</span>
    </a>
    <a href="/lots" data-secao="/lots" class="menu-link flex min-h-12 items-center gap-3 rounded-[10px] px-3.5 font-medium transition-colors hover:bg-hover-neutro" title="Lotes">
      <i class="ph ph-cube text-[22px] text-texto-2" aria-hidden="true"></i>
      <span class="sidebar-label">Lotes</span>
    </a>
    <a href="/analyses/new" data-secao="/analyses" class="menu-link flex min-h-12 items-center gap-3 rounded-[10px] px-3.5 font-medium transition-colors hover:bg-hover-neutro" title="Teste de iodo">
      <i class="ph ph-test-tube text-[22px] text-texto-2" aria-hidden="true"></i>
      <span class="sidebar-label">Teste de iodo</span>
    </a>
    <a href="/usuario" data-secao="/usuario" class="menu-link flex min-h-12 items-center gap-3 rounded-[10px] px-3.5 font-medium transition-colors hover:bg-hover-neutro" title="Perfil">
      <i class="ph ph-user-circle text-[22px] text-texto-2" aria-hidden="true"></i>
      <span class="sidebar-label">Perfil</span>
    </a>
  </nav>

  <a href="/logout" class="menu-link mt-auto flex min-h-12 items-center gap-3 rounded-[10px] px-3.5 font-medium transition-colors hover:bg-hover-neutro" title="Sair">
    <i class="ph ph-sign-out text-[22px] text-texto-2" aria-hidden="true"></i>
    <span class="sidebar-label">Sair</span>
  </a>
</aside>
<div id="sidebarOverlay" class="fixed inset-0 z-30 hidden bg-texto/60 lg:hidden" aria-hidden="true"></div>
