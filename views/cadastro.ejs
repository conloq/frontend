<%- include('partials/header.ejs', { titulo: 'Criar conta' }) %>
<div class="flex min-h-screen bg-superficie">
  <%- include('partials/painelMarca.ejs', { chamada: 'Do teste de iodo à fervura' }) %>
  <main class="flex w-full flex-col items-center justify-between px-6 pb-8 pt-12 lg:w-[864px] lg:shrink-0">
    <span aria-hidden="true"></span>
    <div class="flex w-full max-w-[440px] flex-col gap-7">
      <div class="flex items-center gap-3 lg:hidden">
        <img src="/img/logo-mash.png" alt="" class="size-10 rounded-full">
        <span class="font-display text-xl font-bold tracking-[0.15em]">MASH</span>
      </div>
      <h1 class="text-[32px] font-bold">Criar conta</h1>
      <%- include('partials/mensagens.ejs') %>
      <form id="formCadastro" class="flex flex-col gap-[18px]" novalidate>
        <label class="campo" for="nome">
          <span class="campo-rotulo">Nome completo</span>
          <span class="campo-caixa">
            <i class="ph ph-user" aria-hidden="true"></i>
            <input id="nome" type="text" name="name" autocomplete="name" placeholder="Seu nome" required>
          </span>
        </label>
        <label class="campo" for="email">
          <span class="campo-rotulo">E-mail</span>
          <span class="campo-caixa">
            <i class="ph ph-envelope-simple" aria-hidden="true"></i>
            <input id="email" type="email" name="email" autocomplete="email" placeholder="voce@email.com" required>
          </span>
        </label>
        <div class="campo">
          <label class="campo-rotulo" for="senha">Senha</label>
          <span class="campo-caixa">
            <i class="ph ph-lock-simple" aria-hidden="true"></i>
            <input id="senha" type="password" name="password" autocomplete="new-password" required>
            <button type="button" class="btn-icone -mr-2" data-toggle-senha="senha" aria-label="Mostrar senha"><i class="ph ph-eye" aria-hidden="true"></i></button>
          </span>
          <span class="campo-ajuda">Sem espaços.</span>
        </div>
        <div class="campo" data-campo="confirmarSenha">
          <label class="campo-rotulo" for="confirmarSenha">Confirmar senha</label>
          <span class="campo-caixa">
            <i class="ph ph-lock-simple" aria-hidden="true"></i>
            <input id="confirmarSenha" type="password" name="confirmarSenha" autocomplete="new-password" required>
            <button type="button" class="btn-icone -mr-2" data-toggle-senha="confirmarSenha" aria-label="Mostrar senha"><i class="ph ph-eye" aria-hidden="true"></i></button>
          </span>
          <span class="campo-ajuda" data-erro></span>
        </div>
        <button type="submit" class="btn-primario mt-2 w-full">Criar conta <i class="ph ph-arrow-right" aria-hidden="true"></i></button>
      </form>
      <p class="text-center text-texto-2">Já tem conta? <a href="/login" class="font-semibold text-acao hover:underline">Entrar</a></p>
    </div>
    <p class="text-[13px] text-texto-2">© 2026 Conloq · FATEC Registro</p>
  </main>
</div>
<%- include('partials/footer.ejs') %>
