<%# Monitoramento do lote: histórico de conversão, registros e temperatura, todos vazios até a API ter leituras. %>
<%- include('partials/shellInicio.ejs', { titulo: 'Monitoramento', trilha: ['Lotes', 'Monitoramento'], voltar: `/lots/${locals.id}` }) %>
<div class="flex flex-col gap-2">
  <a href="/lots/<%= locals.id %>" class="btn-voltar self-start max-lg:hidden"><i class="ph ph-arrow-left" aria-hidden="true"></i>Voltar para o lote</a>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h1 class="text-[30px] font-semibold">Monitoramento</h1>
    <a href="/lots/<%= locals.id %>/iodine" class="btn-primario max-lg:hidden"><i class="ph ph-video-camera" aria-hidden="true"></i>Iniciar leitura do iodo</a>
  </div>
</div>

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_420px] xl:items-start">
  <section class="card overflow-hidden" aria-labelledby="tituloConversao">
    <div class="flex flex-col gap-0.5 border-b border-linha px-6 py-5">
      <h2 id="tituloConversao" class="text-lg font-semibold">Histórico de conversão</h2>
      <p class="text-sm text-texto-2">Uma coleta por captura do teste de iodo, da primeira à mais recente.</p>
    </div>
    <%- include('partials/estadoVazio.ejs', { icone: 'ph-test-tube', titulo: 'Nenhuma coleta ainda', texto: 'Presença de amido, conversão parcial e ausência de amido aparecem aqui conforme a câmera classifica.' }) %>
  </section>
  <section class="card overflow-hidden" aria-labelledby="tituloRegistros">
    <h2 id="tituloRegistros" class="border-b border-linha px-6 py-5 text-lg font-semibold">Registros</h2>
    <%- include('partials/estadoVazio.ejs', { icone: 'ph-list-bullets', titulo: 'Sem registros', compacto: true }) %>
  </section>
</div>

<section class="card overflow-hidden" aria-labelledby="tituloTemperaturaMon">
  <h2 id="tituloTemperaturaMon" class="border-b border-linha px-6 py-5 text-lg font-semibold">Temperatura</h2>
  <%- include('partials/estadoVazio.ejs', { icone: 'ph-chart-line', titulo: 'Sem leituras de temperatura', compacto: true }) %>
</section>
<div class="barra-mobile lg:hidden">
  <a href="/lots/<%= locals.id %>/iodine" class="btn-primario w-full"><i class="ph ph-video-camera" aria-hidden="true"></i>Iniciar leitura do iodo</a>
</div>
<%- include('partials/shellFim.ejs') %>
