<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen bg-fundo p-6 text-texto">
  <main class="mx-auto flex max-w-2xl flex-col gap-5 rounded-2xl border border-linha bg-superficie p-6 shadow-sm">
    <header class="flex flex-col gap-2">
      <p class="text-sm font-semibold uppercase tracking-wide text-acao">Demonstração</p>
      <h1 class="text-3xl font-semibold">Tela de exemplo no padrão DW2</h1>
      <p class="leading-relaxed text-texto-2">A rota envia <code>listaClientes</code> para esta view; o EJS percorre a lista e gera cada item no HTML.</p>
    </header>

    <ul class="flex flex-col divide-y divide-linha rounded-xl border border-linha" aria-label="Clientes de exemplo">
      <% listaClientes.forEach(function(cliente) { %>
        <li class="px-4 py-3"><%= cliente %></li>
      <% }); %>
    </ul>

    <p class="text-sm text-texto-2">Total: <%= listaClientes.length %> clientes</p>
  </main>
</body>
</html>
