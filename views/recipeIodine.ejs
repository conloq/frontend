<%# Teste de iodo da receita: rampa, primeira coleta, intervalo e máximo de coletas. Salvar usa data-sem-api (conloq/mash#101); as rampas vêm de GET /recipes/:id/temperatures e a prévia é desenhada pelo app.js com os valores do formulário. %>
<%- include('partials/shellInicio.ejs', { titulo: 'Teste de iodo', trilha: ['Receitas', 'Teste de iodo'], voltar: `/recipes/${locals.id}` }) %>
<form id="formIodoReceita" class="flex flex-1 flex-col gap-6" data-sem-api="conloq/mash#101" novalidate>
  <div class="flex flex-col gap-1 max-lg:contents">
    <a href="/recipes/<%= locals.id %>" class="btn-voltar self-start max-lg:hidden"><i class="ph ph-arrow-left" aria-hidden="true"></i><span id="voltarReceitaIodo">Voltar para a receita</span></a>
    <h1 class="text-[30px] font-semibold max-lg:sr-only">Teste de iodo</h1>
  </div>

  <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_400px] xl:items-start">
    <div class="card flex flex-col gap-5 p-6 max-lg:border-0 max-lg:bg-transparent max-lg:p-0">
      <fieldset class="flex flex-col gap-4">
        <legend class="mb-4 max-lg:mb-2">
          <span class="block font-display text-lg font-semibold">Quando testar</span>
          <span class="text-sm text-texto-2 max-lg:hidden">O teste só vale com o mosto na temperatura e no tempo certos da rampa.</span>
        </legend>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="campo" data-campo="rampa">
            <label class="campo-rotulo" for="iodoRampa">Rampa do teste</label>
            <span class="campo-caixa relative">
              <select id="iodoRampa" name="rampa" required>
                <option value="">Carregando rampas…</option>
              </select>
              <i class="ph ph-caret-down pointer-events-none absolute right-3.5 text-lg!" aria-hidden="true"></i>
            </span>
            <span class="campo-ajuda" data-erro>Normalmente a rampa de sacarificação.</span>
          </div>
          <div class="campo" data-campo="primeiraColeta">
            <label class="campo-rotulo" for="iodoPrimeira">Primeira coleta</label>
            <span class="campo-caixa"><input id="iodoPrimeira" name="primeiraColeta" type="number" min="0" max="240" value="30" inputmode="numeric" required><span class="campo-unidade">min</span></span>
            <span class="campo-ajuda" data-erro>Contado depois que a rampa atinge a temperatura.</span>
          </div>
        </div>
      </fieldset>
      <hr class="border-linha max-lg:hidden">
      <fieldset class="flex flex-col gap-4">
        <legend class="mb-4 max-lg:mb-2">
          <span class="block font-display text-lg font-semibold">Se ainda houver amido</span>
          <span class="text-sm text-texto-2 max-lg:hidden">A mosturação continua nesta rampa e o teste se repete até não haver amido.</span>
        </legend>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="campo" data-campo="intervalo">
            <label class="campo-rotulo" for="iodoIntervalo">Intervalo entre coletas</label>
            <span class="campo-caixa"><input id="iodoIntervalo" name="intervalo" type="number" min="1" max="120" value="10" inputmode="numeric" required><span class="campo-unidade">min</span></span>
            <span class="campo-ajuda">Tempo até a próxima coleta.</span>
          </div>
          <div class="campo" data-campo="maximoColetas">
            <label class="campo-rotulo" for="iodoMaximo">Máximo de coletas</label>
            <span class="campo-caixa"><input id="iodoMaximo" name="maximoColetas" type="number" min="1" max="20" value="6" inputmode="numeric" required><span class="campo-unidade">coletas</span></span>
            <span class="campo-ajuda">Limite de testes por lote.</span>
          </div>
        </div>
      </fieldset>
    </div>

    <aside class="card flex flex-col gap-3 p-6 max-lg:hidden" aria-labelledby="tituloComoFunciona">
      <h2 id="tituloComoFunciona" class="text-lg font-semibold">Como vai funcionar</h2>
      <ul class="flex flex-col gap-3 text-[15px] leading-relaxed">
        <li class="flex gap-3"><i class="ph ph-video-camera mt-1 text-lg text-texto-2" aria-hidden="true"></i>A câmera fixa da bancada captura cada coleta sozinha e compara a cor com os controles calibrados na sessão.</li>
        <li class="flex gap-3"><i class="ph ph-check-circle mt-1 text-lg text-sucesso" aria-hidden="true"></i>Sem amido detectável: a sessão para e o mosto pode seguir para o mash out.</li>
        <li class="flex gap-3"><i class="ph ph-arrow-clockwise mt-1 text-lg text-aviso" aria-hidden="true"></i>Com amido: a mosturação continua na rampa e a captura se repete no intervalo.</li>
        <li class="flex gap-3"><i class="ph ph-warning mt-1 text-lg text-texto-2" aria-hidden="true"></i>Uma captura inconclusiva é repetida e não conta no limite.</li>
      </ul>
    </aside>
  </div>

  <section class="card flex flex-col gap-5 p-6" aria-labelledby="tituloPrevia">
    <div class="flex flex-col gap-0.5">
      <h2 id="tituloPrevia" class="text-lg font-semibold">Prévia da sessão</h2>
      <p id="previaResumo" class="text-sm text-texto-2" aria-live="polite"></p>
    </div>
    <%# Trilho: faixa laranja = duração programada da rampa; números = capturas %>
    <div class="relative h-16 overflow-hidden" aria-hidden="true">
      <div class="absolute inset-x-0 top-2 h-3 rounded-full border border-linha bg-fundo"></div>
      <div id="previaRampa" class="absolute left-0 top-2 h-3 rounded-l-full bg-acao/25"></div>
      <div id="previaCapturas" class="absolute inset-0"></div>
    </div>
    <p class="text-[13px] text-texto-2 max-lg:hidden">A sessão para na primeira captura com ausência de amido detectável ou ao chegar no máximo de capturas. Uma captura inconclusiva é repetida e não conta no limite.</p>
  </section>

  <div class="sticky bottom-0 -mx-4 mt-auto flex flex-wrap items-center gap-3 border-t border-linha bg-superficie px-4 py-4 sm:-mx-6 sm:px-6 lg:-mx-10 lg:-mb-8 lg:px-10">
    <div class="acoes sm:ml-auto">
      <a href="/recipes/<%= locals.id %>" class="btn-secundario">Cancelar</a>
      <button type="submit" class="btn-primario"><span class="lg:hidden">Salvar</span><span class="max-lg:hidden">Salvar teste de iodo</span></button>
    </div>
  </div>
</form>

<template id="tplCalibracaoPrevia">
  <span class="absolute top-0 flex -translate-x-1/2 flex-col items-center gap-1">
    <span class="grid size-7 place-items-center rounded-full border-2 border-info bg-info-suave text-sm text-info"><i class="ph ph-crosshair" aria-hidden="true"></i></span>
    <span class="text-xs font-semibold text-info">Calibração</span>
  </span>
</template>
<template id="tplCapturaPrevia">
  <span class="absolute top-0 flex -translate-x-1/2 flex-col items-center gap-1">
    <span class="grid size-7 place-items-center rounded-full border-2 border-acao bg-superficie text-xs font-semibold text-acao" data-slot="numero"></span>
    <span class="text-xs tabular-nums text-texto-2" data-slot="minuto"></span>
  </span>
</template>
<%- include('partials/shellFim.ejs') %>
