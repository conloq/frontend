<%# Recuperar senha em três etapas (recebe etapa: email, codigo ou redefinir). A API não tem a rota: os formulários usam data-sem-api. %>
<% const etapas = {
  email: { passo: 1, titulo: 'Recuperar senha', texto: 'Informe o e-mail da sua conta para receber um código de 6 dígitos.', botao: 'Enviar código', voltar: ['/login', 'Voltar para o login'] },
  codigo: { passo: 2, titulo: 'Confira seu e-mail', texto: 'Digite o código de 6 dígitos enviado para o seu e-mail.', botao: 'Verificar código', voltar: ['/forgot-password', 'Trocar o e-mail'] },
  redefinir: { passo: 3, titulo: 'Nova senha', texto: 'Crie uma senha nova para entrar no MASH.', botao: 'Salvar nova senha', voltar: ['/login', 'Voltar para o login'] },
}; const etapa = etapas[locals.etapa] ? locals.etapa : 'email'; const e = etapas[etapa]; %>
<%- include('partials/header.ejs', { titulo: e.titulo }) %>
<div class="flex min-h-screen bg-superficie">
  <%- include('partials/painelMarca.ejs', { chamada: 'Do teste de iodo à fervura' }) %>
  <main class="flex w-full flex-col items-center justify-between px-6 pb-8 pt-12 lg:w-[864px] lg:shrink-0">
    <%- include('partials/marcaMobile.ejs', { chamada: 'Do teste de iodo à fervura' }) %>
    <span class="max-lg:hidden" aria-hidden="true"></span>
    <div class="flex w-full max-w-[440px] flex-col gap-7">
      <div class="flex flex-col gap-2">
        <a href="<%= e.voltar[0] %>" class="btn-voltar self-start"><i class="ph ph-arrow-left" aria-hidden="true"></i><%= e.voltar[1] %></a>
        <p class="text-sm font-semibold text-texto-2">Passo <%= e.passo %> de 3</p>
        <h1 class="text-[32px] font-bold"><%= e.titulo %></h1>
        <p class="text-texto-2"><%= e.texto %></p>
      </div>
      <%- include('partials/mensagens.ejs') %>
      <form id="formRecuperar" class="flex flex-col gap-5" data-sem-api="conloq/mash#73" novalidate>
        <% if (etapa === 'email') { %>
          <label class="campo" for="email">
            <span class="campo-rotulo">E-mail</span>
            <span class="campo-caixa">
              <i class="ph ph-envelope-simple" aria-hidden="true"></i>
              <input id="email" type="email" name="email" autocomplete="email" placeholder="voce@email.com" required>
            </span>
          </label>
        <% } else if (etapa === 'codigo') { %>
          <label class="campo" for="codigo">
            <span class="campo-rotulo">Código de 6 dígitos</span>
            <span class="campo-caixa">
              <input id="codigo" name="codigo" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" class="text-center font-display text-2xl tracking-[0.5em]" required>
            </span>
          </label>
        <% } else { %>
          <div class="campo">
            <label class="campo-rotulo" for="senha">Nova senha</label>
            <span class="campo-caixa">
              <i class="ph ph-lock-simple" aria-hidden="true"></i>
              <input id="senha" type="password" name="password" autocomplete="new-password" required>
              <button type="button" class="btn-icone -mr-2" data-toggle-senha="senha" aria-label="Mostrar senha"><i class="ph ph-eye" aria-hidden="true"></i></button>
            </span>
          </div>
          <div class="campo">
            <label class="campo-rotulo" for="confirmarSenha">Confirmar senha</label>
            <span class="campo-caixa">
              <i class="ph ph-lock-simple" aria-hidden="true"></i>
              <input id="confirmarSenha" type="password" name="confirmarSenha" autocomplete="new-password" required>
            </span>
          </div>
        <% } %>
        <button type="submit" class="btn-primario mt-2 w-full"><%= e.botao %></button>
      </form>
    </div>
    <p class="text-[13px] text-texto-2">© 2026 Conloq · FATEC Registro</p>
  </main>
</div>
<%- include('partials/footer.ejs') %>
