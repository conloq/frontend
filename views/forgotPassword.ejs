<%# Recuperar senha em três etapas (recebe etapa: email, codigo ou redefinir). A API não tem a rota: os formulários usam data-sem-api. Desktop: barra da marca, espuma ao fundo e card central; mobile: faixa da marca e formulário. %>
<% const etapas = {
  email: { passo: 1, icone: 'ph-envelope-simple', titulo: 'Recuperar senha', texto: 'Informe o e-mail da sua conta. Enviaremos um código para você criar uma nova senha.', botao: 'Enviar código' },
  codigo: { passo: 2, icone: 'ph-key', titulo: 'Confira seu e-mail', texto: 'Enviamos um código de 6 dígitos para o seu e-mail. Digite-o abaixo para continuar.', botao: 'Verificar código' },
  redefinir: { passo: 3, icone: 'ph-lock-key', titulo: 'Crie uma nova senha', texto: 'Escolha uma senha que você não use em outros sites.', botao: 'Salvar nova senha' },
}; const etapa = etapas[locals.etapa] ? locals.etapa : 'email'; const e = etapas[etapa]; %>
<% const senha = (id, nome, rotulo, ajuda) => { %>
  <div class="campo">
    <label class="campo-rotulo" for="<%= id %>"><%= rotulo %></label>
    <span class="campo-caixa">
      <i class="ph ph-lock-simple" aria-hidden="true"></i>
      <input id="<%= id %>" type="password" name="<%= nome %>" autocomplete="new-password" minlength="8" required>
      <button type="button" class="btn-icone -mr-2" data-toggle-senha="<%= id %>" aria-label="Mostrar senha"><i class="ph ph-eye" aria-hidden="true"></i></button>
    </span>
    <% if (ajuda) { %><span class="campo-ajuda"><%= ajuda %></span><% } %>
  </div>
<% } %>
<%- include('partials/header.ejs', { titulo: e.titulo }) %>
<div class="flex min-h-screen flex-col bg-superficie lg:bg-fundo">
  <header class="hidden h-18 shrink-0 items-center gap-3 bg-mash-brown px-10 lg:flex">
    <img src="/img/logo-mash.png" alt="" class="size-10 rounded-full">
    <span class="font-display text-xl font-bold tracking-wide text-white">MASH</span>
  </header>
  <main class="relative flex flex-1 flex-col px-6 pb-8 pt-12 lg:items-center lg:pt-[150px]">
    <img src="/img/espuma.png" alt="" class="pointer-events-none absolute inset-x-0 top-0 hidden w-full lg:block">
    <%- include('partials/marcaMobile.ejs', { chamada: 'Do teste de iodo à fervura' }) %>
    <div class="relative flex w-full flex-col gap-5 lg:max-w-[480px] lg:gap-6 lg:rounded-2xl lg:bg-superficie lg:px-10 lg:pb-10 lg:pt-8 lg:shadow-[0_24px_48px_rgba(31,26,23,0.12)]">
      <div class="flex items-center justify-between gap-3">
        <a href="/login" class="btn-voltar max-lg:min-h-0 max-lg:border-0 max-lg:bg-transparent max-lg:px-0 max-lg:text-sm"><i class="ph ph-arrow-left" aria-hidden="true"></i>Voltar para o login</a>
        <p class="text-[13px] font-semibold text-texto-2 max-lg:hidden">Passo <%= e.passo %> de 3</p>
      </div>
      <i class="ph <%= e.icone %> text-[34px] text-foco max-lg:hidden" aria-hidden="true"></i>
      <div class="flex flex-col gap-1.5 lg:gap-2">
        <p class="text-[13px] font-semibold text-texto-2 lg:hidden">Passo <%= e.passo %> de 3</p>
        <h1 class="text-[22px] font-semibold lg:text-[32px] lg:font-bold"><%= e.titulo %></h1>
        <p class="text-sm text-texto-2 lg:text-[15px]"><%= e.texto %></p>
      </div>
      <%- include('partials/mensagens.ejs') %>
      <form id="formRecuperar" class="flex flex-col gap-5 lg:gap-6" data-sem-api="conloq/mash#73" novalidate>
        <% if (etapa === 'email') { %>
          <label class="campo" for="email">
            <span class="campo-rotulo">E-mail</span>
            <span class="campo-caixa">
              <i class="ph ph-envelope-simple" aria-hidden="true"></i>
              <input id="email" type="email" name="email" autocomplete="email" placeholder="voce@email.com" required>
            </span>
          </label>
        <% } else if (etapa === 'codigo') { %>
          <fieldset class="flex flex-col gap-2">
            <legend class="sr-only">Código de 6 dígitos</legend>
            <div class="grid grid-cols-6 gap-2" data-codigo>
              <% for (let i = 1; i <= 6; i++) { %>
                <input name="digito<%= i %>" inputmode="numeric" pattern="[0-9]" maxlength="1" aria-label="Dígito <%= i %> de 6" <%- i === 1 ? 'autocomplete="one-time-code"' : 'autocomplete="off"' %> class="aspect-square w-full min-w-0 rounded-[10px] border border-linha bg-superficie text-center font-display text-2xl font-semibold outline-none focus:border-foco focus:ring-2 focus:ring-foco/30" required>
              <% } %>
            </div>
          </fieldset>
        <% } else { %>
          <% senha('senha', 'password', 'Nova senha', 'Mínimo de 8 caracteres.') %>
          <% senha('confirmarSenha', 'confirmarSenha', 'Confirmar nova senha') %>
        <% } %>
        <button type="submit" class="btn-primario w-full"><%= e.botao %><% if (etapa === 'email') { %><i class="ph ph-arrow-right" aria-hidden="true"></i><% } %></button>
        <% if (etapa === 'codigo') { %>
          <p class="text-center text-sm text-texto-2">Não recebeu? <button type="button" class="font-semibold text-texto-2 disabled:cursor-default enabled:text-acao enabled:underline" data-reenviar="45" data-sem-api="conloq/mash#73" disabled>Reenviar em 00:45</button></p>
        <% } %>
      </form>
    </div>
  </main>
</div>
<%- include('partials/footer.ejs') %>
