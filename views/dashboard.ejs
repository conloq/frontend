<%# Painel: a API ainda não tem leituras, alertas, lotes nem dispositivo; cada área mostra o estado vazio. %>
<%- include('partials/shellInicio.ejs', { titulo: 'Painel', trilha: ['Painel', 'Visão geral'] }) %>
<h1 class="text-[30px] font-semibold">Painel</h1>

<section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Indicadores">
  <% [['Temperatura atual', 'ph-thermometer-simple', 'Sem leitura do sensor'],
      ['Lote ativo', 'ph-cube', 'Nenhum lote em andamento'],
      ['Alertas (24 h)', 'ph-bell-simple', 'Sem alertas registrados'],
      ['Teste de iodo', 'ph-test-tube', 'Nenhuma sessão aberta']].forEach(([rotulo, icone, detalhe]) => { %>
    <div class="card flex flex-col gap-1.5 p-5">
      <span class="flex items-center justify-between text-sm text-texto-2"><%= rotulo %><i class="ph <%= icone %> text-xl" aria-hidden="true"></i></span>
      <span class="font-display text-[30px] font-semibold" aria-label="Sem dado">—</span>
      <span class="text-[13px] text-texto-2"><%= detalhe %></span>
    </div>
  <% }) %>
</section>

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_440px]">
  <section class="card overflow-hidden" aria-labelledby="tituloTemperatura">
    <div class="flex flex-col gap-0.5 border-b border-linha px-6 py-5">
      <h2 id="tituloTemperatura" class="text-lg font-semibold">Análise de temperatura</h2>
      <p class="text-sm text-texto-2">Última hora do lote em andamento.</p>
    </div>
    <%- include('partials/estadoVazio.ejs', { icone: 'ph-chart-line', titulo: 'Sem leituras de temperatura', texto: 'O gráfico aparece quando um lote estiver em andamento com o sensor ligado.' }) %>
  </section>
  <section class="card overflow-hidden" aria-labelledby="tituloAlertas">
    <h2 id="tituloAlertas" class="border-b border-linha px-6 py-5 text-lg font-semibold">Alertas recentes</h2>
    <%- include('partials/estadoVazio.ejs', { icone: 'ph-bell-simple', titulo: 'Nenhum alerta', texto: 'Temperatura fora da faixa e avisos do teste de iodo aparecem aqui.' }) %>
  </section>
</div>

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_440px]">
  <section class="card overflow-hidden" aria-labelledby="tituloLotesRecentes">
    <div class="flex items-center justify-between border-b border-linha px-6 py-5">
      <h2 id="tituloLotesRecentes" class="text-lg font-semibold">Lotes recentes</h2>
      <a href="/lots" class="font-semibold text-acao hover:underline">Ver todos</a>
    </div>
    <%- include('partials/estadoVazio.ejs', { icone: 'ph-cube', titulo: 'Nenhum lote ainda', compacto: true, acao: { href: '/lots/new', icone: 'ph-plus', texto: 'Novo lote' } }) %>
  </section>
  <section class="card overflow-hidden" aria-labelledby="tituloControles">
    <h2 id="tituloControles" class="border-b border-linha px-6 py-5 text-lg font-semibold">Controles ativos</h2>
    <%- include('partials/estadoVazio.ejs', { icone: 'ph-plugs', titulo: 'Nenhum dispositivo conectado', texto: 'Controle térmico e câmera da bancada aparecem quando estiverem ligados ao MASH.', compacto: true }) %>
  </section>
</div>
<%- include('partials/shellFim.ejs') %>
