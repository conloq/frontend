<%- include('partials/shellInicio.ejs', { titulo: 'Lotes', trilha: ['Lotes', 'Todos os lotes'] }) %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div class="flex flex-col gap-1.5">
    <h1 class="text-[30px] font-semibold">Lotes</h1>
    <p class="text-texto-2">Cada brassagem, com a receita usada e as fotos do teste de iodo.</p>
  </div>
  <button type="button" class="btn-primario" data-modal-open="modalLote"><i class="ph ph-plus" aria-hidden="true"></i>Novo lote</button>
</div>

<%- include('partials/avisoSemApi.ejs', { issue: 'conloq/mash#31' }) %>

<section class="card overflow-hidden" aria-labelledby="tituloTabelaLotes">
  <h2 id="tituloTabelaLotes" class="sr-only">Lista de lotes</h2>
  <div class="flex flex-wrap items-center gap-3 border-b border-linha px-5 py-4">
    <label class="campo-caixa min-h-11 w-full sm:w-[360px]">
      <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
      <span class="sr-only">Buscar lote ou receita</span>
      <input id="buscaLotes" type="search" placeholder="Buscar lote ou receita" autocomplete="off">
    </label>
    <div class="flex min-h-11 w-full gap-1 rounded-[10px] bg-fundo p-1 sm:w-auto" role="group" aria-label="Filtrar por status">
      <button type="button" data-filtro="todos" aria-pressed="true" class="flex-1 whitespace-nowrap rounded-lg px-3 text-sm font-medium text-texto-2 aria-pressed:bg-superficie aria-pressed:font-semibold aria-pressed:text-texto aria-pressed:shadow-sm">Todos</button>
      <button type="button" data-filtro="active" aria-pressed="false" class="flex-1 whitespace-nowrap rounded-lg px-3 text-sm font-medium text-texto-2 aria-pressed:bg-superficie aria-pressed:font-semibold aria-pressed:text-texto aria-pressed:shadow-sm">Em andamento</button>
      <button type="button" data-filtro="completed" aria-pressed="false" class="flex-1 whitespace-nowrap rounded-lg px-3 text-sm font-medium text-texto-2 aria-pressed:bg-superficie aria-pressed:font-semibold aria-pressed:text-texto aria-pressed:shadow-sm">Concluídos</button>
    </div>
    <span class="ml-auto text-sm text-texto-2">3 lotes</span>
  </div>
  <div class="tabela-cabecalho hidden min-h-11 items-center gap-4 px-5 md:grid md:grid-cols-[minmax(0,1fr)_200px_190px_190px_140px_60px]" aria-hidden="true">
    <span>Lote</span><span>Receita</span><span>Início da mosturação</span><span>Análises de iodo</span><span>Status</span><span></span>
  </div>
  <div id="listaLotes">
    <% [
      ['Lote 12/03', 'American Pale Ale', '20/10/2026 · 14:05', '2 análises · em processamento', 'active'],
      ['Lote 05/03', 'Witbier', '05/10/2026 · 09:30', '4 análises', 'completed'],
      ['Lote 26/02', 'Dry Stout', '26/09/2026 · 15:10', '3 análises', 'completed'],
    ].forEach(([nome, receita, inicio, analises, status]) => { %>
      <div class="tabela-linha grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 gap-y-1 px-5 py-4 md:min-h-[68px] md:grid-cols-[minmax(0,1fr)_200px_190px_190px_140px_60px] md:items-center md:py-0" data-lote data-status="<%= status %>" data-busca="<%= `${nome} ${receita}`.toLowerCase() %>">
        <a href="/lots/1" class="truncate font-semibold hover:text-acao hover:underline"><%= nome %></a>
        <span class="truncate text-sm text-texto-2 max-md:col-start-1 md:text-[15px] md:text-texto"><%= receita %></span>
        <span class="text-sm text-texto-2 max-md:col-start-1 md:text-[15px] md:text-texto"><%= inicio %></span>
        <span class="text-sm text-texto-2 max-md:col-start-1"><%= analises %></span>
        <span class="max-md:col-start-2 max-md:row-start-1"><% if (status === 'active') { %><span class="selo-aviso">Em andamento</span><% } else { %><span class="selo-sucesso">Concluído</span><% } %></span>
        <a href="/lots/1" class="btn-icone -mr-2 justify-self-end max-md:hidden" aria-label="Abrir <%= nome %>"><i class="ph ph-caret-right" aria-hidden="true"></i></a>
      </div>
    <% }) %>
    <div id="lotesVazio" class="hidden flex-col items-center gap-3 px-6 py-16 text-center">
      <span class="grid size-16 place-items-center rounded-full bg-acao-suave text-3xl text-foco"><i class="ph ph-magnifying-glass" aria-hidden="true"></i></span>
      <p class="font-display text-xl font-semibold">Nenhum lote encontrado</p>
      <p class="text-texto-2">Mude a busca ou o filtro de status.</p>
    </div>
  </div>
</section>

<%- include('partials/modalLote.ejs', { titulo: 'Novo lote', descricao: 'Um lote é uma brassagem feita com uma das suas receitas.', botao: 'Criar lote' }) %>
<%- include('partials/shellFim.ejs') %>
