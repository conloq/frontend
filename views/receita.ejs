<%- include ('partials/header.ejs') %>
<div class="app-shell min-h-screen bg-stone-100 lg:flex">
  <%- include('partials/sidebar.ejs')%>
  <div class="app-shell-content min-w-0 flex-1">
    <%- include('partials/topBar.ejs')%>
    <main class="mx-auto max-w-7xl p-4 sm:p-6">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="text-3xl font-bold text-mash-brown">Receitas</h1>
        <button
          type="button"
          data-modal-open="modalCriarProcesso"
          aria-label="Adicionar receita"
          class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-mash-orange px-4 font-bold text-white transition hover:bg-orange-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-300"
        >
          <i class="ph ph-plus" aria-hidden="true"></i
          ><span class="hidden sm:inline">Adicionar receita</span>
        </button>
      </div>
      <section class="overflow-x-auto rounded-3xl bg-white shadow-sm">
        <div class="min-w-[680px]">
          <div
            class="grid grid-cols-[1.5fr_1fr_1fr_1fr_150px] gap-4 border-b border-stone-100 p-5 text-xs font-bold uppercase tracking-wide text-stone-400"
          >
            <span>Nome processo</span><span>Início do timer</span
            ><span>Temperatura mín.</span><span>Temperatura máx.</span
            ><span>Ações</span>
          </div>
          <div
            class="grid grid-cols-[1.5fr_1fr_1fr_1fr_150px] items-center gap-4 border-b border-stone-50 p-5 text-sm"
          >
            <span class="font-semibold text-mash-brown">Receita Pilsen</span>
            <span>08:00:00</span><span>64°C</span><span>66°C</span
            ><span class="flex items-center gap-2"
              ><a
                href="/receita/temperatura/criar/1"
                class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg bg-sky-600 p-2 font-bold text-white transition hover:bg-sky-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300"
                title="Adicionar temperatura"
                aria-label="Adicionar temperatura"
                ><i class="ph ph-plus" aria-hidden="true"></i></a
              ><a
                href="/receita/temperatura/editar/1"
                class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg bg-amber-500 p-2 font-bold text-white transition hover:bg-amber-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300"
                aria-label="Editar temperatura"
                title="Editar temperatura"
                ><i class="ph ph-pencil-simple" aria-hidden="true"></i
              ></a>
              <form onsubmit="return false;" onsubmit="return false;">
                <input type="hidden" name="receitaId" value="1" /><button
                  title="Excluir receita"
                  aria-label="Excluir receita"
                  class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg bg-red-600 p-2 font-bold text-white transition hover:bg-red-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-300"
                >
                  <i class="ph ph-trash" aria-hidden="true"></i>
                </button>
              </form>
            </span>
          </div>
          <div
            class="grid grid-cols-[1.5fr_1fr_1fr_1fr_150px] items-center gap-4 border-b border-stone-50 p-5 text-sm"
          >
            <span class="font-semibold text-mash-brown">Receita IPA</span>
            <span>-</span><span>-</span><span>-</span
            ><span class="flex items-center gap-2"
              ><a
                href="/receita/temperatura/criar/2"
                class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg bg-sky-600 p-2 font-bold text-white transition hover:bg-sky-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300"
                title="Adicionar temperatura"
                aria-label="Adicionar temperatura"
                ><i class="ph ph-plus" aria-hidden="true"></i></a
              ><a
                href="/receita/temperatura/editar/2"
                class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg bg-amber-500 p-2 font-bold text-white transition hover:bg-amber-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300"
                aria-label="Editar temperatura"
                title="Editar temperatura"
                ><i class="ph ph-pencil-simple" aria-hidden="true"></i
              ></a>
              <form onsubmit="return false;" onsubmit="return false;">
                <input type="hidden" name="receitaId" value="2" /><button
                  title="Excluir receita"
                  aria-label="Excluir receita"
                  class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg bg-red-600 p-2 font-bold text-white transition hover:bg-red-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-300"
                >
                  <i class="ph ph-trash" aria-hidden="true"></i>
                </button>
              </form>
            </span>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>
<div
  id="modalCriarProcesso"
  class="js-modal fixed inset-0 z-50 hidden bg-stone-950/60 p-4"
  aria-hidden="true"
>
  <div class="flex min-h-full items-center justify-center">
    <div
      class="w-full max-w-md rounded-3xl bg-white p-6 shadow-xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modalCriarProcessoLabel"
    >
      <div class="flex items-center justify-between">
        <h2
          id="modalCriarProcessoLabel"
          class="text-xl font-bold text-mash-brown"
        >
          Criar processo
        </h2>
        <button
          type="button"
          data-modal-close
          class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg p-2 text-2xl text-stone-500 transition hover:bg-stone-100 hover:text-stone-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-300"
          aria-label="Fechar"
        >
          <i class="ph ph-x" aria-hidden="true"></i>
        </button>
      </div>
      <form onsubmit="return false;" class="mt-5">
        <label for="processoNome" class="block text-sm font-semibold"
          >Nome da receita</label
        ><input
          type="text"
          id="processoNome"
          name="nome"
          placeholder="Digite o nome do processo"
          required
          class="mt-2 w-full rounded-xl border border-stone-200 px-4 py-3 outline-none focus:border-mash-orange focus:ring-2 focus:ring-orange-200"
        /><button
          type="submit"
          class="mt-5 min-h-11 w-full rounded-xl bg-mash-orange font-bold text-white"
        >
          Adicionar
        </button>
      </form>
    </div>
  </div>
</div>
<%- include ('partials/footer.ejs') %>
