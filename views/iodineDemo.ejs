<%- include('partials/shellInicio.ejs', { titulo: 'Teste de iodo', trilha: ['Teste de iodo', 'Nova análise'] }) %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div class="flex flex-col gap-1.5">
    <h1 class="text-[30px] font-semibold">Teste de iodo</h1>
    <p class="max-w-3xl text-texto-2">Como vai funcionar: a câmera da bancada fotografará cada amostra com iodo e o MASH classificará a cor; a decisão de seguir para a fervura continuará sendo sua.</p>
  </div>
  <div class="acoes">
    <button type="button" id="demoReiniciar" class="btn-secundario"><i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>Reiniciar</button>
    <button type="button" id="demoIniciar" class="btn-primario"><i class="ph ph-play" aria-hidden="true"></i>Iniciar teste</button>
  </div>
</div>

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_440px]">
  <section class="card flex flex-col overflow-hidden" aria-labelledby="tituloCamera">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-linha px-6 py-5">
      <div class="flex flex-col gap-0.5">
        <h2 id="tituloCamera" class="text-lg font-semibold">Lote 12/03 · American Pale Ale</h2>
        <p class="text-sm text-texto-2">Rampa 2 de 3 · 66 ºC · mosturação há <span id="demoTempo">00:20</span></p>
      </div>
      <span id="demoAoVivo" class="selo-info">Aguardando início</span>
    </div>

    <div class="grid flex-1 gap-6 p-6 md:grid-cols-[260px_minmax(0,1fr)] md:items-center">
      <%# Placa da amostra: a cor muda conforme a leitura simulada %>
      <div class="relative mx-auto grid aspect-square w-full max-w-[260px] place-items-center rounded-2xl bg-mash-brown-dark" aria-hidden="true">
        <span class="absolute left-3 top-3 flex items-center gap-1.5 text-xs font-semibold text-header-texto-2"><i class="ph-fill ph-camera"></i>Câmera da bancada</span>
        <span id="demoAmostra" class="size-36 rounded-full bg-[#b9b0a8] shadow-[inset_0_-12px_24px_rgba(0,0,0,0.35)] transition-colors duration-700 motion-reduce:transition-none"></span>
        <span id="demoLendo" class="absolute bottom-3 hidden items-center gap-1.5 text-xs font-semibold text-white"><i class="ph ph-circle-notch animate-spin motion-reduce:animate-none"></i>Lendo a cor…</span>
      </div>

      <div class="flex flex-col gap-4" aria-live="polite">
        <div class="flex flex-col gap-1">
          <span class="text-sm text-texto-2">Leitura atual</span>
          <p id="demoResultado" class="font-display text-[28px] font-semibold">Nenhuma coleta ainda</p>
          <p id="demoDescricao" class="text-texto-2">Inicie o teste para ver as coletas acontecendo.</p>
        </div>
        <div>
          <div class="mb-2 flex justify-between text-xs font-semibold text-texto-2"><span>Amido presente</span><span>Sem amido</span></div>
          <div class="relative h-3 rounded-full bg-linear-to-r from-[#2b1a3d] via-[#9c3d1e] to-[#e9b949]">
            <span id="demoMarcador" class="absolute -top-1.5 hidden size-6 -translate-x-1/2 rounded-full border-4 border-superficie bg-texto shadow transition-[left] duration-700 motion-reduce:transition-none" style="left: 0%"></span>
          </div>
        </div>
        <div id="demoPronto" class="hidden items-center gap-3 rounded-[10px] bg-sucesso-suave px-4 py-3">
          <i class="ph-fill ph-check-circle text-[22px] text-sucesso" aria-hidden="true"></i>
          <p><strong class="font-semibold">Pronto para a fervura.</strong> A amostra não reage mais ao iodo.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="card self-start overflow-hidden" aria-labelledby="tituloColetas">
    <div class="flex flex-col gap-0.5 border-b border-linha px-6 py-5">
      <h2 id="tituloColetas" class="text-lg font-semibold">Coletas deste lote</h2>
      <p class="text-sm text-texto-2">Uma coleta a cada 10 minutos, até 6 testes.</p>
    </div>
    <ol id="demoColetas" class="flex flex-col px-6 py-2">
      <li id="demoSemColetas" class="py-6 text-center text-sm text-texto-2">As coletas aparecem aqui.</li>
    </ol>
  </section>
</div>

<%# Uma coleta da linha do tempo %>
<template id="tplColeta">
  <li class="tabela-linha flex items-center gap-3 py-3.5">
    <span class="size-7 shrink-0 rounded-md" data-slot="cor"></span>
    <span class="flex min-w-0 flex-1 flex-col gap-0.5">
      <span class="font-semibold" data-slot="resultado"></span>
      <span class="text-[13px] text-texto-2" data-slot="detalhe"></span>
    </span>
    <span class="text-sm font-medium" data-slot="hora"></span>
  </li>
</template>
<%- include('partials/shellFim.ejs') %>
